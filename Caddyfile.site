# in-container static server; tls and domains handled by the front proxy
{
	admin off
	auto_https off
}

:80 {
	root * /srv/site
	encode zstd gzip

	header {
		# lets Tor Browser advertise the onion mirror on clearnet visits
		Onion-Location "http://avkean56kkkrrjvqksx6rjlidh3ws4ad6pzefs5mxqchw6p634aaawad.onion{uri}"
		# same idea for I2P-capable clients (community convention, not a spec)
		X-I2P-Location "http://avkeanm7ldgvhz36zij3ntphilipw2dc43j4rhqumzvmh7usanta.b32.i2p{uri}"
		Content-Security-Policy "default-src 'none'; style-src 'self'; font-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Cross-Origin-Opener-Policy same-origin
		Cross-Origin-Resource-Policy same-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# the astro integration emits sitemap-index.xml; keep the conventional name working
	rewrite /sitemap.xml /sitemap-index.xml

	@immutable path /_astro/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	@pgp path /pgp.asc
	header @pgp Content-Type "text/plain; charset=utf-8"

	handle_errors {
		@404 expression {http.error.status_code} == 404
		rewrite @404 /404.html
		file_server
	}

	file_server
}
