{
	admin off
	auto_https off
}

(security_headers) {
	header {
		Onion-Location "http://avkean56kkkrrjvqksx6rjlidh3ws4ad6pzefs5mxqchw6p634aaawad.onion{http.request.orig_uri}"
		X-I2P-Location "http://avkeanm7ldgvhz36zij3ntphilipw2dc43j4rhqumzvmh7usanta.b32.i2p{http.request.orig_uri}"
		Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Cross-Origin-Opener-Policy same-origin
		Cross-Origin-Resource-Policy same-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}

:80 {
	root * /srv/site
	encode zstd gzip
	import security_headers

	@tls_proxy header X-Forwarded-Proto https
	header @tls_proxy Strict-Transport-Security "max-age=31536000"

	@www host www.avkean.com
	redir @www https://avkean.com{uri} permanent

	rewrite /sitemap.xml /sitemap-index.xml

	@immutable path /_astro/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	@mutable not path /_astro/*
	header @mutable Cache-Control "no-cache"

	@pgp path /pgp.asc
	header @pgp Content-Type "text/plain; charset=utf-8"

	handle_errors {
		import security_headers
		@tls_proxy_error header X-Forwarded-Proto https
		header @tls_proxy_error Strict-Transport-Security "max-age=31536000"
		header Cache-Control "no-cache"
		@404 expression {http.error.status_code} == 404
		rewrite @404 /404.html
		file_server
	}

	file_server
}
