---
interface Props {
  title: string;
  crumbs?: { label: string; href: string }[];
}
const { title, crumbs = [{ label: '~', href: '/' }] } = Astro.props;
---

<nav class="crumbs" aria-label="Breadcrumb">
  {crumbs.map((c) => <a href={c.href}>{c.label}/</a>)}<span aria-current="page">{title}</span>
</nav>
<h1>{title}</h1>

<style>
  .crumbs {
    margin-bottom: var(--s3);
    font-size: 0.875rem;
    color: var(--muted);
  }
  .crumbs a {
    color: var(--muted);
    text-decoration-color: currentColor;
    display: inline-block;
    /* enlarge the hit area without moving anything */
    padding: 0.5em 0.35em;
    margin: -0.5em -0.35em;
  }

  h1 {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--red);
    margin-bottom: var(--s2);
  }
</style>
