---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="infra · avner"
  themeColor="#0e0e0e"
  description="What I run myself. Forgejo, Matrix, a Tor relay, and two dn42 nodes."
>
  <main>
    <PageHeader title="infra" />

    <p>
      Most of this runs on one small VPS in Singapore, as containers behind
      Caddy.
    </p>

    <section>
      <h2>What I run</h2>
      <dl class="stack">
        <div>
          <dt>Forgejo</dt><dd><a href="https://git.avkean.com/" target="_blank" rel="noopener">git.avkean.com</a>, where my code lives</dd>
        </div>
        <div>
          <dt>Matrix</dt><dd>the homeserver behind <a href="https://matrix.to/#/@avner:avkean.com" target="_blank" rel="noopener">@avner:avkean.com</a></dd>
        </div>
        <div>
          <dt>dn42</dt><dd><code>AS4242420421</code>, my two nodes (<a href="/dn42/">peering page</a>)</dd>
        </div>
        <div>
          <dt>Tor</dt><dd>a relay named <a href="https://metrics.torproject.org/rs.html#details/154DED50860DA2F14D91C36182024D37DD950CF8" target="_blank" rel="noopener">ratatoskr</a>, and this site&rsquo;s <a href="/mirrors/">onion mirror</a></dd>
        </div>
      </dl>
    </section>

    <p class="note">
      Everything else runs quietly.
    </p>

    <Footer />
  </main>
</Base>

<style>
  .note {
    margin-top: var(--s4);
  }
</style>
