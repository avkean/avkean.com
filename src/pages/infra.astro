---
import Base from '../layouts/Base.astro';
---

<Base
  title="infra · avner"
  description="What Avner runs: Forgejo, SearXNG, Matrix, Tor, dn42, and supporting infrastructure."
>
  <header class="page-head">
    <h1>infra</h1>
    <p class="lede">A few public services and the servers behind them.</p>
  </header>

  <section class="page-section">
    <h2>services</h2>
    <ul class="service-list">
      <li>
        <h3>Forgejo</h3>
        <p>
          <a href="https://git.avkean.com/" target="_blank" rel="noopener">git.avkean.com</a>,
          where my code lives.
        </p>
      </li>
      <li>
        <h3>SearXNG</h3>
        <p>
          Metasearch at{' '}
          <a href="https://searxng.avkean.com/" target="_blank" rel="noopener"
            >searxng.avkean.com</a
          >, with an{' '}
          <a
            href="http://lyybdkn77b44vcqp7rc3fbcdgugzm7ygsce2mthjyztqhbjpdfqmt2qd.onion"
            target="_blank"
            rel="noopener">onion service</a
          > too.
        </p>
      </li>
      <li>
        <h3>Matrix</h3>
        <p>
          My homeserver is <a
            href="https://matrix.to/#/@avner:avkean.com"
            target="_blank"
            rel="noopener">@avner:avkean.com</a
          >.
        </p>
      </li>
      <li>
        <h3>dn42</h3>
        <p>AS4242420421, with two nodes and a <a href="/dn42/">peering page</a>.</p>
      </li>
      <li>
        <h3>Tor</h3>
        <p>
          <a
            href="https://metrics.torproject.org/rs.html#details/154DED50860DA2F14D91C36182024D37DD950CF8"
            target="_blank"
            rel="noopener">ratatoskr</a
          > and this site’s <a href="/mirrors/">onion mirror</a>.
        </p>
      </li>
      <li>
        <h3>Status</h3>
        <p>
          Current service health at <a
            href="https://status.avkean.com/"
            target="_blank"
            rel="noopener">status.avkean.com</a
          >.
        </p>
      </li>
    </ul>
  </section>

  <section class="page-section">
    <h2>servers</h2>
    <ul class="plates server-list" aria-label="Servers">
      <li class="plate server fill-steel">
        <h3>sg1</h3>
        <p>Singapore</p>
      </li>
      <li class="plate server fill-plum">
        <h3>ca1</h3>
        <p>Montreal</p>
      </li>
    </ul>
    <p class="closing">Everything else runs quietly.</p>
  </section>
</Base>
