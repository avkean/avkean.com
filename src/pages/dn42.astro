---
import Base from '../layouts/Base.astro';
---

<Base
  title="dn42 · avner"
  description="Peering information, endpoints, and network details for AS4242420421."
>
  <header class="page-head">
    <h1>dn42</h1>
    <p class="lede">
      <a href="https://dn42.dev/" target="_blank" rel="noopener">dn42</a>{' '}
      is an overlay network where hobbyists run real BGP between themselves. This is my peering
      page.
    </p>
  </header>

  <section class="page-section">
    <h2>peering</h2>
    <p>
      Peering is open. <a href="mailto:infra@avkean.com">Email me</a>{' '}
      your ASN, endpoint, WireGuard key, and link-local. Use whichever node is closer.
    </p>
    <p>
      Sessions are MP-BGP over IPv6 link-local with extended next hop, dn42 routes only. Current
      peers are on the{' '}
      <a href="https://lg.avkean.com/" target="_blank" rel="noopener">looking glass</a>.
    </p>
  </section>

  <section class="page-section">
    <h2>nodes</h2>
    <p class="node-note">
      Both listen on port <code class="port">2<var>XXXX</var></code>. XXXX is the last four digits of
      your ASN.
    </p>

    <ul class="plates nodes" aria-label="dn42 nodes">
      <li class="plate node fill-steel">
        <h3>sg <span>Singapore</span></h3>
        <dl class="node-fields">
          <div>
            <dt>endpoint</dt>
            <dd>
              <code>sg.dn42.avkean.com:<span class="port">2<var>XXXX</var></span></code>
            </dd>
          </div>
          <div>
            <dt>wireguard</dt>
            <dd><code>avkeanHyNlKN+YU4zxnrQTTIEyaE+djuZABwxfaj0T0=</code></dd>
          </div>
          <div>
            <dt>link-local</dt>
            <dd><code>fe80::421</code></dd>
          </div>
          <div>
            <dt>addresses</dt>
            <dd><code>172.20.242.21</code><br /><code>fd42:4242:421::1</code></dd>
          </div>
        </dl>
      </li>

      <li class="plate node fill-violet">
        <h3>us <span>Oregon</span></h3>
        <dl class="node-fields">
          <div>
            <dt>endpoint</dt>
            <dd>
              <code>us.dn42.avkean.com:<span class="port">2<var>XXXX</var></span></code>
            </dd>
          </div>
          <div>
            <dt>wireguard</dt>
            <dd><code>avkeanGRr7VyffvrWYaMImhSk7Bmb1i1UTipfDD1JDY=</code></dd>
          </div>
          <div>
            <dt>link-local</dt>
            <dd><code>fe80::422</code></dd>
          </div>
          <div>
            <dt>addresses</dt>
            <dd><code>172.20.242.22</code><br /><code>fd42:4242:421::2</code></dd>
          </div>
        </dl>
      </li>
    </ul>
  </section>

  <section class="page-section">
    <h2>network</h2>
    <dl class="network-grid">
      <div>
        <dt>asn</dt>
        <dd><code>AS4242420421</code></dd>
      </div>
      <div>
        <dt>ipv4</dt>
        <dd><code>172.20.242.0/27</code></dd>
      </div>
      <div>
        <dt>ipv6</dt>
        <dd><code>fd42:4242:421::/48</code></dd>
      </div>
      <div>
        <dt>registry</dt>
        <dd><code>AVKEAN-MNT</code><br /><code>AVKEAN-DN42</code></dd>
      </div>
      <div>
        <dt>contact</dt>
        <dd><a href="mailto:infra@avkean.com">infra@avkean.com</a></dd>
      </div>
      <div>
        <dt>looking glass</dt>
        <dd>
          <a href="https://lg.avkean.com/" target="_blank" rel="noopener">lg.avkean.com</a>
        </dd>
      </div>
    </dl>
  </section>
</Base>
